name: Trace checks

on:
  push:
    branches: [main]
    paths:
      - 'stoa-trace/**'
      - '.github/workflows/stoa-trace.yml'
  pull_request:
    paths:
      - 'stoa-trace/**'
      - '.github/workflows/stoa-trace.yml'

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-24.04
    defaults:
      run:
        working-directory: stoa-trace
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: actions/setup-python@v7.1.0
        with:
          python-version: '3.11'
          cache: pip
          cache-dependency-path: stoa-trace/requirements.txt
      - uses: actions/setup-node@v7.1.0
        with:
          node-version-file: stoa-trace/.nvmrc
          cache: npm
          cache-dependency-path: stoa-trace/frontend/package-lock.json
      - run: python -m pip install -r requirements.txt
      - run: python -m unittest discover -s tests -v
      - run: python ops/benchmark.py --dry-run
      - run: npm ci
        working-directory: stoa-trace/frontend
      - run: npm run build
        working-directory: stoa-trace/frontend
