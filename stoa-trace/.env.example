# Put real API secrets in your private .env or ~/.config/stoa-junction-2026/secrets.env.
# Gemini can also use the private ~/.config/stoa-junction-2026/gemini.env sidecar.
# Optional evidence close-ups use ~/.config/stoa-junction-2026/cloudinary.env.
# CLOUDINARY_URL=cloudinary://<private API key>:<private API secret>@<cloud name>
# STOA_CLOUDINARY_UPLOAD_PRESET=trace-evidence-pages
# Run python ops/setup_cloudinary.py once before enabling close-ups.
STOA_DATA_ROOT=./datasets/junction-dataset-preview
STOA_RUNTIME_DIR=./runtime
STOA_PROVIDER=openai
STOA_MODEL=gpt-6-astra
# To switch: STOA_PROVIDER=gemini, STOA_MODEL=gemini-4-argon, GEMINI_API_KEY=<private key>.
# Keep the actual key outside this example. Restart after changing providers.
# STOA_GEMINI_IMAGE_RESOLUTION=ultra_high
# Supported: low, medium, high, ultra_high. Compare on development files first.
# Prepared analysis policy; unset defaults remain high reasoning / caller cap / 240s.
# The output cap includes reasoning tokens, not just the structured answer.
# STOA_GEMINI_THINKING_LEVEL=medium
# STOA_GEMINI_MAX_OUTPUT_TOKENS=24000
# STOA_GEMINI_TIMEOUT_SECONDS=600
# Optional second-model visual review through the same private Google key.
# STOA_VISUAL_AUDIT_MODEL=gemma-4-31b-it
# STOA_GEMMA_THINKING_LEVEL=minimal
# CubiCasa5K plans use that collection's annotation conventions; none turns them off.
# STOA_ANNOTATION_PROFILE=cubicasa
# Repeated visual readings per page by the same model (1, 2 or 3; default 2; each is a
# model call). The first gives the count; a different count flags the answer for review.
# STOA_INVENTORY_READINGS=2
STOA_MAX_MODEL_CALLS=50
STOA_HOST=127.0.0.1
STOA_PORT=8787
# Estimated token costs before credits are tracked per message and browser session.
# Dated Carbon/Gemma published rates are bundled; unknown/expired rates stay unknown.
# Optional exact-model overrides. They are estimates, not invoice totals:
# STOA_PRICE_MODEL=gemini/gemini-4-argon
# STOA_INPUT_USD_PER_MILLION=
# STOA_CACHED_INPUT_USD_PER_MILLION=
# STOA_OUTPUT_USD_PER_MILLION=
# Enlarged overlapping crops for small plans in the visual inventory (comparison arm b).
# STOA_SMALL_IMAGE_CROPS=1
